# epocha 单节点部署的 compose 变量样例。
# 复制为同目录 `.env`（`docker compose` 会自动读取），按需修改。
# **不要把真实密钥写进这个文件**：这里的任何一项都不承载密钥材料，密钥只走 keys/ 目录里的文件。
# `.env` 已在仓库 .gitignore 里排除；本样例文件只放占位符。

# --- 镜像与版本注入 ---
# 三个值由 make docker-image 从 git 读出后传入；手工构建时它们决定
# `epocha --version` 与备份 manifest 里的 app_version/commit 能否对上仓库。
EPOCHA_IMAGE=epocha:5a
EPOCHA_VERSION=0.0.0-dev
EPOCHA_COMMIT=none
EPOCHA_BUILD_DATE=unknown

# --- 宿主端口边界 ---
# 必须保持 127.0.0.1。改成 0.0.0.0（或删掉这个前缀）会把验证服务直接发布到公网网卡。
EPOCHA_PUBLIC_BIND=127.0.0.1
EPOCHA_PUBLIC_PORT=8080

# --- 目录与身份 ---
# 数据目录（SQLite 主文件 + WAL）与密钥目录**必须分开**：
# DESIGN §6 的安全前提是 pepper 与 DB 不同库存放，两者同进一次备份等于摘要保护归零。
EPOCHA_DATA_DIR=./data
EPOCHA_KEY_DIR=./keys
# 备份目录：单独挂载、可写、不在数据目录里面。恢复**不**用这个目录，
# 而是拷到隔离目录（或用一次性容器）做——见 docs/BACKUP-RESTORE.md。
EPOCHA_BACKUP_DIR=./backups
# uid/gid 必须与上面两个目录的属主一致（docs/DEPLOYMENT.md §2 有一条 install/chown 命令）。
# 65534 = nobody；建一个专用系统用户时把它改掉。
EPOCHA_UID=65534
EPOCHA_GID=65534

# --- 资源限额（1 vCPU / 1GB）---
# 数值来自阶段 5A 的资源演练实测（docs/STAGE5A.md），不是拍脑袋：
# 验证服务硬上限 128MiB + GOMEMLIMIT 56MiB，给宿主 OS 与反代留出余量。
EPOCHA_CPUS=1.0
EPOCHA_MEM_LIMIT=128m
EPOCHA_MEMSWAP_LIMIT=128m
EPOCHA_PIDS_LIMIT=128

# --- 日志轮转 ---
EPOCHA_LOG_MAX_SIZE=5m
EPOCHA_LOG_MAX_FILE=3

# --- 网络与来源地址 ---
# 钉住的 compose 子网：宿主上的反代经发布端口进入容器时，源地址是这个网络的网关。
EPOCHA_NETWORK=epocha_default
EPOCHA_SUBNET=172.28.0.0/24
# 默认 false：只信容器看到的 TCP 对端地址（红线 9）。
# 有同机反代时置 true，并把受信网段填成**上面那个子网**（不是 127.0.0.1，也不是 0.0.0.0/0）。
# 只置 true 而留空网段会直接拒绝启动。
EPOCHA_TRUST_PROXY=false
# EPOCHA_TRUSTED_PROXIES=172.28.0.0/24

# --- 可选：管理凭据引导文件 ---
# 只在"第一次启动、库里还没有任何管理凭据"时需要的引导路径。
# 容器内绝对路径；文件权限 0600、属主 = EPOCHA_UID。
# 留空 = 不引导，管理面在登记凭据前拒绝所有请求（缺凭据不等于放开管理功能）。
# EPOCHA_ADMIN_KEY_FILE=/etc/epocha/keys/admin

# --- 可选：题型白名单 ---
# 留空 = 登记全部已知题型。
# **生产默认不要落在 text-image 的低难度档**：阶段 4B 的真实 OCR 基线显示低档整串通过率 96%，
# 挡不住通用 OCR（DESIGN §8.4、红线 14）。难度由站点配置决定，不在这里。
# EPOCHA_GENERATORS=arithmetic-baseline-v1,text-image-v1
