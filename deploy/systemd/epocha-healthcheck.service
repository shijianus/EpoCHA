[Unit]
Description=EpoCHA readiness observation
OnFailure=epocha-alert@%n.service

[Service]
Type=oneshot
User=1000
Group=1000
UMask=0077
ExecStart=/usr/local/bin/epocha-ops check --base-url http://127.0.0.1:8080 --path /readyz
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=15s
