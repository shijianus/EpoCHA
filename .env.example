# epocha 运行时环境变量样例。
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，**不要提交真实值**。
# 生成方式：openssl rand -base64 32

# 令牌签名主密钥（必需）。缺失则服务拒绝启动（DESIGN §6）。
EPOCHA_MASTER_KEY=REPLACE_ME_32BYTES_BASE64

# 密钥/答案摘要用的 pepper（必需）。必须与 DB 文件分开存放——两者同处一库则摘要保护失效。
EPOCHA_PEPPER=REPLACE_ME_32BYTES_BASE64

# 首次启动登记的管理密钥（仅当库中尚无 admin 记录时生效，之后可清空）。
EPOCHA_ADMIN_KEY=REPLACE_ME_32BYTES_BASE64

# 可选
# EPOCHA_DB=/var/lib/epocha/epocha.db
# EPOCHA_LISTEN=127.0.0.1:8080
# EPOCHA_TRUST_PROXY=false          # 只有源站防火墙已只放行 CF 段时才置 true（DESIGN §9）
# EPOCHA_MASTER_KEY_PREVIOUS=       # kid 轮换期间的旧主密钥
