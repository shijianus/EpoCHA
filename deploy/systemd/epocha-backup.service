[Unit]
Description=EpoCHA online consistent backup
OnFailure=epocha-alert@%n.service

[Service]
Type=oneshot
User=1000
Group=1000
UMask=0077
Environment=EPOCHA_PEPPER_FILE=/etc/epocha/keys/pepper
ExecStart=/usr/local/bin/epocha-ops backup --db /var/lib/epocha/epocha.db --dest /var/backups/epocha
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/epocha /etc/epocha/keys
ReadWritePaths=/var/backups/epocha
TimeoutStartSec=10min
