# epocha 运行时环境变量样例。
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，**不要提交真实值**。
# 生成方式：openssl rand -base64 32

# 令牌签名主密钥（必需）。缺失则服务拒绝启动（DESIGN §6）。
EPOCHA_MASTER_KEY=REPLACE_ME_32BYTES_BASE64

# 密钥/凭据摘要用的 pepper（必需）。必须与 DB 文件分开存放——两者同处一库则摘要保护失效。
EPOCHA_PEPPER=REPLACE_ME_32BYTES_BASE64

# 管理凭据引导（可选）。值是运维实际发出的 Bearer 令牌本身（**不做 base64 变换**），
# 因此建议直接用高熵串：ak_$(openssl rand -hex 32)
# 仅当库里**没有任何管理凭据记录**时登记一次；之后这个变量被完全忽略，
# 撤销与新增都只能通过管理 API 做（DESIGN §6、ADR-010）。
# 留空且库里无记录 = 管理面拒绝所有请求（缺凭据不等于放开管理功能）。
EPOCHA_ADMIN_KEY=

# 可选：监听地址
# EPOCHA_LISTEN=127.0.0.1:8080
# EPOCHA_ADMIN_LISTEN=127.0.0.1:8081     # 管理 API 独立监听器；公共端口上没有管理路由
# EPOCHA_DB=/var/lib/epocha/epocha.db
# EPOCHA_SITES_FILE=/etc/epocha/sites.json   # 仅作**一次性导入**：库里已有同 site_key 时该条不生效

# 可选：令牌有效期（上下界 [1s, 3600s]；有效期长度等于防重放必须保留的窗口长度）
# EPOCHA_CHALLENGE_TTL_SEC=180
# EPOCHA_RESPONSE_TTL_SEC=120

# 可选：滥用防护。速率（下面三项）与存量（后两项）是两个正交的量，DESIGN §9、ADR-009。
# EPOCHA_RATE_IP_RPM=60
# EPOCHA_RATE_SITE_RPM=300
# EPOCHA_RATE_MAX_STATES=8192
# EPOCHA_MAX_ACTIVE_CHALLENGES=10000              # 全局同时存在的活动 challenge 行数上限
# EPOCHA_MAX_ACTIVE_CHALLENGES_PER_SITE=2000      # 单站点上限
# EPOCHA_MAX_LEDGER_ROWS=100000                    # 全部历史 challenge 行硬上限（独立于活动上限）

# 可选：主密钥 kid 轮换期间的旧密钥
# EPOCHA_MASTER_KEY_PREVIOUS=

# 可选：只有源站防火墙已只放行 CF 段时才置 true（DESIGN §12）
# EPOCHA_TRUST_PROXY=false
# EPOCHA_TRUSTED_PROXIES=198.51.100.0/24,203.0.113.0/24

# 可选：生成式题池（阶段 3A，DESIGN §8.3、docs/STAGE3A.md）。
# 这些值只影响"题从哪来、什么时候补"，不影响安全判定；未启用池的站点（verify_mode=pow_only）完全不看它们。
# EPOCHA_POOL_ENABLED=true                 # 置 false/0 关闭后台补题：pow_question 站点池空时得到 503，不会降级成 PoW-only
# EPOCHA_POOL_LOW_WATERMARK=50             # 低于此值触发补题
# EPOCHA_POOL_HIGH_WATERMARK=100            # 补到此值停止（迟滞撤除线，必须 >= 低水位）
# EPOCHA_POOL_MAX_ROWS=20000                # 题池行数硬上限（必须 >= 高水位）；判定与插入在同一条 SQL 内
# EPOCHA_POOL_WORKERS=1                     # 并发生成数，硬上限 4（1 vCPU 机器上调高没有意义）
# EPOCHA_POOL_QUESTION_TTL_SEC=4200         # 单题可领取时长；**必须大于站点最大 challenge TTL(3600)**，否则永远领不到题
# EPOCHA_POOL_POLL_MS=2000                  # 水位检查周期，下限 100ms
